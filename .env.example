# Copy this file to .env and choose your own passwords:  cp .env.example .env
# .env is gitignored and must never be committed.
# SQL Server requires 8+ characters with upper case, lower case, a digit and a symbol.
# Use '-' or '!' as the symbol: avoid @ : / # % because the passwords go inside a URL.
MSSQL_SA_PASSWORD=ChangeMe-Sa-123
TICKETS_DB_PASSWORD=ChangeMe-Tickets-123
CHECKIN_DB_PASSWORD=ChangeMe-Checkin-123
